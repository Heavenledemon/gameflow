# Include /api. Do not add a trailing slash.
VITE_API_BASE_URL=https://your-gameflow-backend.vercel.app/api
VITE_GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com

# Optional build metadata and feature flags.
VITE_RELEASE_VERSION=production
VITE_REEL_FEED_V2_ENABLED=false
VITE_REEL_VIRTUALIZATION_ENABLED=false
VITE_REALTIME_OUTBOX_WORKER_ENABLED=false
VITE_OBJECT_STORAGE_ENABLED=false
