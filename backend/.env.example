MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/gameflow?retryWrites=true&w=majority
CLIENT_ORIGIN=https://your-game-flow-ui.vercel.app
AUTH_TOKEN_SECRET=replace-with-a-long-random-secret
SEED_ON_START=false
REQUEST_TIMEOUT_MS=15000

# Optional: required for cross-instance realtime event distribution.
REDIS_URL=

# Optional: production uploads must use persistent S3-compatible storage.
OBJECT_STORAGE_ENABLED=false
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
