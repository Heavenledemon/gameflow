{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "express",
  "rewrites": [
    {
      "source": "/webgl-frame-adapter.js",
      "destination": "https://gameflow-flow-ui.vercel.app/webgl-frame-adapter.js"
    },
    {
      "source": "/media-storage/:path*",
      "destination": "https://swqaxkqpegwoscyiuitm.supabase.co/storage/v1/object/public/gameflow-media/:path*"
    }
  ],
  "headers": [
    {
      "source": "/media-storage/(.*)\\.html",
      "headers": [
        { "key": "Content-Type", "value": "text/html; charset=utf-8" },
        { "key": "Content-Security-Policy", "value": "default-src 'self' data: blob:; script-src 'self' 'unsafe-inline' 'unsafe-eval' 'wasm-unsafe-eval' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' data: blob:; connect-src 'self' data: blob:; worker-src 'self' blob:" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    },
    {
      "source": "/media-storage/(.*)\\.js",
      "headers": [{ "key": "Content-Type", "value": "application/javascript; charset=utf-8" }]
    },
    {
      "source": "/media-storage/(.*)\\.wasm\\.br",
      "headers": [
        { "key": "Content-Type", "value": "application/wasm" }
      ]
    },
    {
      "source": "/media-storage/(.*)\\.js\\.br",
      "headers": [
        { "key": "Content-Type", "value": "application/javascript; charset=utf-8" }
      ]
    },
    {
      "source": "/media-storage/(.*)\\.data\\.br",
      "headers": [
        { "key": "Content-Type", "value": "application/octet-stream" }
      ]
    },
    {
      "source": "/media-storage/(.*)\\.wasm\\.gz",
      "headers": [
        { "key": "Content-Type", "value": "application/wasm" }
      ]
    },
    {
      "source": "/media-storage/(.*)\\.js\\.gz",
      "headers": [
        { "key": "Content-Type", "value": "application/javascript; charset=utf-8" }
      ]
    },
    {
      "source": "/media-storage/(.*)\\.data\\.gz",
      "headers": [
        { "key": "Content-Type", "value": "application/octet-stream" }
      ]
    }
  ],
  "functions": {
    "index.js": {
      "maxDuration": 60
    }
  }
}
